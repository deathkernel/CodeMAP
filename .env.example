# ---------------------------------------------------------------
# Backend (read by the FastAPI app from this file)
# ---------------------------------------------------------------
CODEMAP_ENV=development
CODEMAP_DATABASE_URL=sqlite:///./data/codemap.db
CODEMAP_MAX_UPLOAD_MB=50
CODEMAP_MAX_ARCHIVE_FILES=5000
CODEMAP_MAX_EXTRACTED_MB=250
CODEMAP_MAX_SOURCE_FILE_MB=2

# Local Ollama endpoint. Source code must remain on this local endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/bartowski/Qwen_Qwen3.5-9B-GGUF:Q6_K
OLLAMA_REQUEST_TIMEOUT_SECONDS=240

# Local embeddings for semantic code search (optional).
# Install once with: ollama pull nomic-embed-text
CODEMAP_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------
# Frontend (Next.js reads frontend/.env.local, NOT this file)
# Create frontend/.env.local with:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Only set it if the backend is not at the default (http://localhost:8000).
# ---------------------------------------------------------------
