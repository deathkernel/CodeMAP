# Backend
CODEMAP_ENV=development
CODEMAP_DATABASE_URL=sqlite:///./data/codemap.db
CODEMAP_MAX_UPLOAD_MB=50
CODEMAP_MAX_ARCHIVE_FILES=5000
CODEMAP_MAX_EXTRACTED_MB=250
CODEMAP_MAX_SOURCE_FILE_MB=2

# Local Ollama endpoint. Source code must remain on this local endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/bartowski/Qwen_Qwen3.5-9B-GGUF:Qwen3.5-9B-Q6_K.gguf
OLLAMA_REQUEST_TIMEOUT_SECONDS=240

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
